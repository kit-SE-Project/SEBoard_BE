{
  "mode": "PROXMOX",
  "gateway_protocol": "NODE_HELPER_V02",
  "backend_url": "https://allday-api.internal.example",
  "worker_id": "allday-manager-1",
  "worker_token": "REPLACE_WITH_PRIVATE_WORKER_TOKEN",
  "agent_token": "REPLACE_WITH_SEPARATE_PRIVATE_AGENT_TOKEN",
  "bind": "127.0.0.1",
  "port": 19090,
  "state_path": ".local/manager.sqlite3",
  "server_ids": [
    1,
    2,
    3
  ],
  "allow_real_mutations": false,
  "network_isolation_confirmed": false,
  "proxmox": {
    "url": "https://pve.internal.example:8006",
    "token_id": "allday@pve!manager",
    "token_secret": "REPLACE_WITH_PRIVATE_PVE_TOKEN_SECRET",
    "ca_file": "/run/secrets/pve-ca.pem"
  },
  "nodes": {
    "1": {
      "node_name": "pve-1",
      "gpu_enabled": false,
      "gpu_mapping": null,
      "vm_bridge": "vmbr1",
      "vm_pool": "allday-1",
      "gateway": "10.70.1.1",
      "public_ssh_port": 7541,
      "helper": {
        "host": "192.0.2.21",
        "port": 22,
        "key_file": "/run/secrets/allday-helper-key",
        "known_hosts_file": "/run/secrets/known_hosts",
        "timeout": 30
      }
    },
    "2": {
      "node_name": "pve-2",
      "gpu_enabled": true,
      "gpu_mapping": "allday-gpu-2",
      "vm_bridge": "vmbr1",
      "vm_pool": "allday-2",
      "gateway": "10.70.2.1",
      "public_ssh_port": 7542,
      "helper": {
        "host": "192.0.2.22",
        "port": 22,
        "key_file": "/run/secrets/allday-helper-key",
        "known_hosts_file": "/run/secrets/known_hosts",
        "timeout": 30
      }
    },
    "3": {
      "node_name": "pve-3",
      "gpu_enabled": true,
      "gpu_mapping": "allday-gpu-3",
      "vm_bridge": "vmbr1",
      "vm_pool": "allday-3",
      "gateway": "10.70.3.1",
      "public_ssh_port": 7543,
      "helper": {
        "host": "192.0.2.23",
        "port": 22,
        "key_file": "/run/secrets/allday-helper-key",
        "known_hosts_file": "/run/secrets/known_hosts",
        "timeout": 30
      }
    }
  }
}
