[Unit]
Description=Server Allday Management Worker and Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=allday
WorkingDirectory=/opt/server-allday-manager
ExecStart=/usr/bin/python3 -m manager.server --config /opt/server-allday-manager/.local/config.json
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/server-allday-manager/.local

[Install]
WantedBy=multi-user.target
