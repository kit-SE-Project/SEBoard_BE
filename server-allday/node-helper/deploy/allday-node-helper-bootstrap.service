[Unit]
Description=Server Allday closed ingress initialization
After=networking.service pve-cluster.service
Before=pve-guests.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/server-allday/node-helper/run_helper.py --config /etc/server-allday/node-helper/config.json bootstrap
RemainAfterExit=yes
PrivateTmp=yes
ProtectHome=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
